rules_version = '2';

// Regras do Firestore do WealthFlow — cole no console do Firebase
// (Firestore Database → Regras → Publicar) DEPOIS de configurar o login no Vercel.
//
// Só o usuário 'wf-owner' lê ou grava. Esse usuário só existe para quem acertou o PIN
// no servidor (api/login.js). Login anônimo, que qualquer pessoa consegue fazer, é recusado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'wf-owner';
    }
  }
}
